bool servoOutputUsedByOther(uint8_t logicalId, uint8_t channel) {
  if (channel >= 7) return false;

  uint8_t count = planeVisibleCount();
  for (uint8_t i = 0; i < count; i++) {
    uint8_t otherId = planeLogicalId(i);
    if (otherId != logicalId && servo_channel_map[otherId] == channel) {
      return true;
    }
  }
  return false;
}

uint8_t findNextFreeServoOutput(uint8_t logicalId, int8_t direction) {
  int current = constrain(servo_channel_map[logicalId], 0, 7);
  int candidate = current;

  for (uint8_t tries = 0; tries < 8; tries++) {
    candidate += direction;
    if (candidate > 7) candidate = 0;
    if (candidate < 0) candidate = 7;

    if (candidate == 7 || !servoOutputUsedByOther(logicalId, (uint8_t)candidate)) {
      return (uint8_t)candidate;
    }
  }

  return (uint8_t)current;
}

void softSPI_init() {
  pinMode(MOSI_PIN, OUTPUT);
  pinMode(MISO_PIN, INPUT);
  pinMode(SCK_PIN, OUTPUT);
  pinMode(CSN_PIN, OUTPUT);
  pinMode(CE_PIN, OUTPUT);

  PORTB |= _BV(PB0);
  PORTD &= ~_BV(PD7);
  PORTB &= ~_BV(PB5);
}

static inline void nrf_csn_low()  { PORTB &= ~_BV(PB0); }
static inline void nrf_csn_high() { PORTB |=  _BV(PB0); }
static inline void nrf_ce_low()   { PORTD &= ~_BV(PD7); }
static inline void nrf_ce_high()  { PORTD |=  _BV(PD7); }

uint8_t softSPI_transfer(uint8_t data) {
  uint8_t received = 0;
  for (uint8_t mask = 0x80; mask; mask >>= 1) {
    if (data & mask) PORTD |= _BV(PD3);
    else             PORTD &= ~_BV(PD3);

    PORTB |= _BV(PB5);
    if (PIND & _BV(PD2)) received |= mask;
    PORTB &= ~_BV(PB5);
  }
  return received;
}

uint8_t read_register(uint8_t reg) {
  nrf_csn_low();
  softSPI_transfer(R_REGISTER | (reg & 0x1F));
  uint8_t value = softSPI_transfer(NOP);
  nrf_csn_high();
  return value;
}

void write_register(uint8_t reg, uint8_t value) {
  nrf_csn_low();
  softSPI_transfer(W_REGISTER | (reg & 0x1F));
  softSPI_transfer(value);
  nrf_csn_high();
}

void write_register_buf(uint8_t reg, const uint8_t *data, uint8_t len) {
  nrf_csn_low();
  softSPI_transfer(W_REGISTER | (reg & 0x1F));
  for (uint8_t i = 0; i < len; i++) {
    softSPI_transfer(data[i]);
  }
  nrf_csn_high();
}

uint8_t get_status(void) {
  nrf_csn_low();
  uint8_t status = softSPI_transfer(NOP);
  nrf_csn_high();
  return status;
}

void flush_tx(void) {
  nrf_csn_low();
  softSPI_transfer(FLUSH_TX);
  nrf_csn_high();
}

void flush_rx(void) {
  nrf_csn_low();
  softSPI_transfer(FLUSH_RX);
  nrf_csn_high();
}

uint32_t packServoMap() {
  uint32_t packed = 0;
  for (uint8_t i = 0; i < 8; i++) {
    uint8_t v = (uint8_t)constrain(servo_channel_map[i], 0, 7);
    packed |= ((uint32_t)v & 0x07UL) << (i * 3);
  }
  packed |= ((uint32_t)(plane_type & 0x03)) << 24;
  packed |= ((uint32_t)(servo_reverse_mask & 0x3FU)) << 26;
  return packed;
}

void updateTxServoMap() {
  txData.servoMapPacked = packServoMap();
}

bool activateFeaturesIfNeeded() {
  uint8_t feature = read_register(FEATURE);

  feature |= 0x06;
  write_register(FEATURE, feature);

  if ((read_register(FEATURE) & 0x06) != 0x06) {
    nrf_csn_low();
    softSPI_transfer(ACTIVATE);
    softSPI_transfer(0x73);
    nrf_csn_high();

    feature = read_register(FEATURE) | 0x06;
    write_register(FEATURE, feature);
  }

  write_register(DYNPD, read_register(DYNPD) | 0x03);

  return ((read_register(FEATURE) & 0x06) == 0x06) &&
         ((read_register(DYNPD) & 0x03) == 0x03);
}

uint8_t readDynamicPayloadWidth() {
  nrf_csn_low();
  softSPI_transfer(R_RX_PL_WID);
  uint8_t width = softSPI_transfer(NOP);
  nrf_csn_high();
  return width;
}

bool readAckTelemetry() {
  if ((read_register(FIFO_STATUS) & 0x01) != 0) {
    return false;
  }

  uint8_t width = readDynamicPayloadWidth();

  if (width == 0 || width > 32) {
    flush_rx();
    write_register(STATUS, 0x40);
    return false;
  }

  if (width != sizeof(TelemetryData)) {

    nrf_csn_low();
    softSPI_transfer(R_RX_PAYLOAD);
    for (uint8_t i = 0; i < width; i++) {
      softSPI_transfer(NOP);
    }
    nrf_csn_high();

    write_register(STATUS, 0x40);
    return false;
  }

  nrf_csn_low();
  softSPI_transfer(R_RX_PAYLOAD);

  uint8_t *p = (uint8_t *)&telemetryData;
  for (uint8_t i = 0; i < sizeof(TelemetryData); i++) {
    p[i] = softSPI_transfer(NOP);
  }

  nrf_csn_high();

  write_register(STATUS, 0x40);

  telemetryReceived = true;
  lastTelemetryReceive = millis();
  lastValidBatteryPerc = telemetryData.batteryPercent;

  return true;
}

void radio_init() {
  write_register(CONFIG, 0x00);
  write_register(EN_AA, 0x01);
  write_register(EN_RXADDR, 0x01);
  write_register(SETUP_AW, 0x03);
  write_register(SETUP_RETR, 0x12);
  write_register(RF_CH, 100);
  write_register(RF_SETUP, 0x06);

  write_register_buf(TX_ADDR, arduino_tx_addr, 5);
  write_register_buf(RX_ADDR_P0, arduino_tx_addr, 5);

  write_register(RX_PW_P0, 0);
  ackDynamicEnabled = activateFeaturesIfNeeded();

  write_register(STATUS, 0x70);
  flush_tx();
  flush_rx();

  write_register(CONFIG, 0x0E);
  radioPowerUpMs = millis();
  radioConfigured = true;
}

void serviceRadioInit() {
  unsigned long now = millis();

  if (!radioConfigured) {
    if ((unsigned long)(now - radioBootMs) >= 100UL) {
      radio_init();
    }
    return;
  }

  if (!radioReady && (unsigned long)(now - radioPowerUpMs) >= 5UL) {
    radioReady = true;
    lastControlSendUs = micros();
  }
}

void startDataTx() {
  if (!radioReady || radioState != RADIO_IDLE) return;

  if ((read_register(FIFO_STATUS) & 0x01) == 0) {
    readAckTelemetry();
  } else {
    write_register(STATUS, 0x40);
  }

  updateTxServoMap();
  write_register(STATUS, 0x30);

  nrf_csn_low();
  softSPI_transfer(W_TX_PAYLOAD);
  uint8_t* dataPtr = (uint8_t*)&txData;
  for (uint8_t i = 0; i < sizeof(TransmitterData); i++) {
    softSPI_transfer(dataPtr[i]);
  }
  nrf_csn_high();

  nrf_ce_high();
  radioTxStartUs = micros();
  radioState = RADIO_CE_PULSE;
  radioTxBusy = true;
}

int8_t serviceDataTx() {
  unsigned long nowUs = micros();

  if (radioState == RADIO_IDLE) return 0;

  if (radioState == RADIO_CE_PULSE) {
    if ((unsigned long)(nowUs - radioTxStartUs) >= 15UL) {
      nrf_ce_low();
      radioTxStartUs = nowUs;
      radioState = RADIO_WAIT_TX;
    }
    return 0;
  }

  if (radioState == RADIO_WAIT_TX) {
    uint8_t status = get_status();

    if (status & 0x20) {
      lastRetryCount = read_register(OBSERVE_TX) & 0x0F;
      bool gotTelemetry = false;

      if (ackDynamicEnabled &&
          ((status & 0x40) || ((read_register(FIFO_STATUS) & 0x01) == 0))) {
        gotTelemetry = readAckTelemetry();
      }

      write_register(STATUS, 0x30);

      radioState = RADIO_IDLE;
      radioTxBusy = false;
      return gotTelemetry ? 2 : 1;
    }

    if (status & 0x10) {
      lastRetryCount = 15;
      write_register(STATUS, 0x30);
      flush_tx();

      radioState = RADIO_IDLE;
      radioTxBusy = false;
      return -1;
    }

    if ((unsigned long)(nowUs - radioTxStartUs) > 3500UL) {
      lastRetryCount = 15;
      write_register(STATUS, 0x30);
      flush_tx();

      radioState = RADIO_IDLE;
      radioTxBusy = false;
      return -1;
    }
  }

  return 0;
}

int mapJoystickToChannel(int value, int center, int deadzone) {
  int delta = value - center;
  if (abs(delta) <= deadzone) return 2048;

  if (delta > 0) {
    long active = (long)value - (center + deadzone);
    long span = 1023L - (center + deadzone);
    if (span < 1) span = 1;
    long mapped = 2048L + CONTROL_START_COUNTS +
                  (active * (2047L - CONTROL_START_COUNTS)) / span;
    return (int)constrain(mapped, 2048L, 4095L);
  } else {
    long active = (long)(center - deadzone) - value;
    long span = (long)(center - deadzone);
    if (span < 1) span = 1;
    long mapped = 2048L - CONTROL_START_COUNTS -
                  (active * (2048L - CONTROL_START_COUNTS)) / span;
    return (int)constrain(mapped, 0L, 2048L);
  }
}

int applyDeadzone(int value, int center, int deadzone) {
  if (abs(value - center) < deadzone) return center;
  return value;
}

int readAnalogPinClean(int pin) {
  int a = analogRead(pin);
  int b = analogRead(pin);
  int c = analogRead(pin);

  if (a > b) { int t = a; a = b; b = t; }
  if (b > c) { int t = b; b = c; c = t; }
  if (a > b) { int t = a; a = b; b = t; }

  return b;
}

uint16_t applyExpoRateChannel(uint16_t input) {
  int32_t d = (int32_t)input - 2048L;
  if (d == 0) return 2048;

  int32_t a = (d < 0) ? -d : d;

  int32_t cubic = (d * a) / 2048L;
  cubic = (cubic * a) / 2048L;

  int effectiveExpo = constrain(expo_value, 0, 100);
  int maxExpoBlend = 100 - MIN_EXPO_LINEAR_PERCENT;
  int expoBlend = (effectiveExpo * maxExpoBlend) / 100;
  int linearBlend = 100 - expoBlend;

  int32_t mixed = (d * (int32_t)linearBlend +
                   cubic * (int32_t)expoBlend) / 100L;

  int effectiveRate = constrain(rate_value, 20, 100);
  int32_t scaled = (mixed * (int32_t)effectiveRate) / 100L;

  int32_t minScaled = ((int32_t)CONTROL_START_COUNTS * effectiveRate) / 100L;
  if (minScaled < CONTROL_START_COUNTS) minScaled = CONTROL_START_COUNTS;
  if (scaled > 0 && scaled < minScaled) scaled = minScaled;
  if (scaled < 0 && scaled > -minScaled) scaled = -minScaled;

  int32_t out = 2048L + scaled;
  if (out < 0) out = 0;
  if (out > 4095) out = 4095;
  return (uint16_t)out;
}

void readButtons() {
  int leftVal = analogRead(LeftPadButtons);
  int rightVal = analogRead(RightPadButtons);

  buttonLeftUp = false; buttonLeftLeft = false;
  buttonLeftRight = false; buttonLeftDown = false;
  buttonRightUp = false; buttonRightLeft = false;
  buttonRightRight = false; buttonRightDown = false;

  if (leftVal >= 120 && leftVal <= 200) buttonLeftUp = true;
  else if (leftVal >= 240 && leftVal <= 320) buttonLeftLeft = true;
  else if (leftVal >= 430 && leftVal <= 520) buttonLeftRight = true;
  else if (leftVal >= 950) buttonLeftDown = true;

  if (rightVal >= 120 && rightVal <= 200) buttonRightUp = true;
  else if (rightVal >= 380 && rightVal <= 470) buttonRightLeft = true;
  else if (rightVal >= 950) buttonRightDown = true;
}

void handleToggles() {
  bool toggle1 = (digitalRead(Toggle1) == LOW);
  bool toggle2 = (digitalRead(Toggle2) == LOW);
  bool toggle3 = (digitalRead(Toggle3) == LOW);
  bool toggle4 = (digitalRead(Toggle4) == LOW);

  if (toggle3) {
    flightMode = MODE_STABILIZE;
    txData.channels[4] = 2048;
  } else if (toggle2) {
    flightMode = MODE_ACRO;
    txData.channels[4] = 4095;
  } else {
    flightMode = MODE_MANUAL;
    txData.channels[4] = 0;
  }

  gearDown = toggle4;
  txData.channels[5] = gearDown ? 4095 : 0;

  lastToggle1 = toggle1;
  lastToggle2 = toggle2;
  lastToggle3 = toggle3;
  lastToggle4 = toggle4;

  txData.toggles[0] = toggle1;
  txData.toggles[1] = toggle2;
  txData.toggles[2] = toggle3;
  txData.toggles[3] = toggle4;
}

void loadSettings() {
  EEPROM.get(EEPROM_ADDR, savedSettings);
  if (savedSettings.magic != EEPROM_MAGIC) {
    savedSettings.magic = EEPROM_MAGIC;
    savedSettings.trim_aileron = 0;
    savedSettings.trim_elevator = 0;
    savedSettings.trim_rudder = 0;
    savedSettings.trim_flaps = 0;
    savedSettings.rate_value = 80;
    savedSettings.expo_value = 30;
    savedSettings.plane_type = 0;
    for(int i=0; i<8; i++) savedSettings.servo_channel_map[i] = 7;
    savedSettings.reverse_magic = EEPROM_REVERSE_MAGIC;
    savedSettings.servo_reverse_mask = 0;
    saveSettings();
  }
  trim_aileron = constrain(savedSettings.trim_aileron, -100, 100);
  trim_elevator = constrain(savedSettings.trim_elevator, -100, 100);
  trim_rudder = constrain(savedSettings.trim_rudder, -100, 100);
  trim_flaps = constrain(savedSettings.trim_flaps, -100, 100);
  rate_value = constrain(savedSettings.rate_value, 20, 100);
  expo_value = constrain(savedSettings.expo_value, 0, 100);

  plane_type = savedSettings.plane_type;
  if (plane_type < PLANE_WING || plane_type > PLANE_V_TAIL) {
    plane_type = PLANE_WING;
  }

  for (int i = 0; i < 8; i++) {
    int v = savedSettings.servo_channel_map[i];
    servo_channel_map[i] = (v >= 0 && v <= 7) ? v : 7;
  }
  // Existing installations used the same EEPROM_MAGIC but had no reverse byte.
  // A separate marker lets us preserve all old settings and safely default reversing to NORMAL.
  servo_reverse_mask = (savedSettings.reverse_magic == EEPROM_REVERSE_MAGIC)
      ? (savedSettings.servo_reverse_mask & 0x3FU)
      : 0U;
  sanitizePlaneMap();
}

void saveSettings() {
  savedSettings.magic = EEPROM_MAGIC;
  savedSettings.trim_aileron = trim_aileron;
  savedSettings.trim_elevator = trim_elevator;
  savedSettings.trim_rudder = trim_rudder;
  savedSettings.trim_flaps = trim_flaps;
  savedSettings.rate_value = rate_value;
  savedSettings.expo_value = expo_value;
  savedSettings.plane_type = plane_type;
  for(int i=0; i<8; i++) savedSettings.servo_channel_map[i] = servo_channel_map[i];
  savedSettings.reverse_magic = EEPROM_REVERSE_MAGIC;
  savedSettings.servo_reverse_mask = servo_reverse_mask & 0x3FU;
  EEPROM.put(EEPROM_ADDR, savedSettings);
}

void resetSettingsToDefaults() {
  trim_aileron = 0;
  trim_elevator = 0;
  trim_rudder = 0;
  trim_flaps = 0;
  rate_value = 80;
  expo_value = 30;
  plane_type = PLANE_WING;
  flapPosition = 0;
  trim_adjust_mode = false;
  trim_selection = 0;
  servo_assign_selection = 0;
  servo_reverse_selection = 0;
  servo_reverse_mask = 0;
  for (int i = 0; i < 8; i++) servo_channel_map[i] = 7;
  sanitizePlaneMap();
  updatePlaneServoMap();
  saveSettings();
}

void handleMenuButtons() {

  if (current_screen == SCREEN_MENU) {
    if (buttonLeftUp && !menu_up_pressed) {
      item_selected--;
      menu_up_pressed = true;
      if (item_selected < 0) { item_selected = NUM_ITEMS - 1; }
    } else if (!buttonLeftUp) {
      menu_up_pressed = false;
    }

    if (buttonLeftDown && !menu_down_pressed) {
      item_selected++;
      menu_down_pressed = true;
      if (item_selected >= NUM_ITEMS) { item_selected = 0; }
    } else if (!buttonLeftDown) {
      menu_down_pressed = false;
    }

    if (buttonRightUp && !menu_select_pressed) {
      menu_select_pressed = true;
      switch(item_selected) {
        case 0: current_screen = SCREEN_DASHBOARD; break;
        case 1: current_screen = SCREEN_DUAL_RATES; break;
        case 2: current_screen = SCREEN_ALL_TRIMS; break;
        case 3: current_screen = SCREEN_PLANE_TYPE; break;
        case 4:
          current_screen = SCREEN_SERVO_MIX;
          servo_reverse_selection = 0;
          // Right-Up is also TOGGLE on the mix screen. Keep it latched until released.
          servo_reverse_toggle_latch = true;
          servo_reverse_back_latch = buttonRightDown;
          break;
        case 5:
          current_screen = SCREEN_SAVE_SETTINGS;
          settings_reset_confirm = false;
          settings_reset_latch = buttonRightLeft;
          break;
        default: break;
      }
    } else if (!buttonRightUp) {
      menu_select_pressed = false;
    }

  } else if (current_screen == SCREEN_SAVE_SETTINGS) {
    if (settings_reset_confirm) {
      // Confirmation: Right-Up = YES, Right-Down = NO.
      if (buttonRightUp && !menu_select_pressed) {
        menu_select_pressed = true;
        resetSettingsToDefaults();
        settings_reset_confirm = false;
        current_screen = SCREEN_MENU;
      } else if (!buttonRightUp) {
        menu_select_pressed = false;
      }

      if (buttonRightDown && !menu_exit_pressed) {
        menu_exit_pressed = true;
        settings_reset_confirm = false;
      } else if (!buttonRightDown) {
        menu_exit_pressed = false;
      }

      if (!buttonRightLeft) settings_reset_latch = false;
    } else {
      // Normal settings screen: Right-Up = SAVE, Right-Left = RESET, Right-Down = BACK.
      if (buttonRightUp && !menu_select_pressed) {
        menu_select_pressed = true;
        saveSettings();
        current_screen = SCREEN_MENU;
      } else if (!buttonRightUp) {
        menu_select_pressed = false;
      }

      if (buttonRightLeft && !settings_reset_latch) {
        settings_reset_latch = true;
        settings_reset_confirm = true;
      } else if (!buttonRightLeft) {
        settings_reset_latch = false;
      }

      if (buttonRightDown && !menu_exit_pressed) {
        menu_exit_pressed = true;
        current_screen = SCREEN_MENU;
      } else if (!buttonRightDown) {
        menu_exit_pressed = false;
      }
    }

  } else if (current_screen == SCREEN_PLANE_TYPE) {
    if (buttonLeftUp && !menu_up_pressed) {
      plane_type++;
      if (plane_type > PLANE_V_TAIL) plane_type = PLANE_WING;
      sanitizePlaneMap();
      servo_assign_selection = 0;
      menu_up_pressed = true;
    } else if (!buttonLeftUp) {
      menu_up_pressed = false;
    }

    if (buttonLeftDown && !menu_down_pressed) {
      plane_type--;
      if (plane_type < PLANE_WING) plane_type = PLANE_V_TAIL;
      sanitizePlaneMap();
      servo_assign_selection = 0;
      menu_down_pressed = true;
    } else if (!buttonLeftDown) {
      menu_down_pressed = false;
    }

    if (buttonRightUp && !menu_select_pressed) {
      menu_select_pressed = true;
      current_screen = SCREEN_SERVO_ASSIGN;
      servo_assign_selection = 0;

      servo_back_latch = true;
      servo_output_dec_latch = buttonRightLeft;
      servo_output_inc_latch = buttonRightDown;
    } else if (!buttonRightUp) {
      menu_select_pressed = false;
    }

    if (buttonRightDown && !menu_exit_pressed) {
      menu_exit_pressed = true;
      current_screen = SCREEN_MENU;
    } else if (!buttonRightDown) {
      menu_exit_pressed = false;
    }

  } else if (current_screen == SCREEN_SERVO_ASSIGN) {
    if (buttonLeftUp && !menu_up_pressed) {
      servo_assign_selection--;
      if (servo_assign_selection < 0) servo_assign_selection = planeVisibleCount() - 1;
      menu_up_pressed = true;
    } else if (!buttonLeftUp) {
      menu_up_pressed = false;
    }

    if (buttonLeftDown && !menu_down_pressed) {
      servo_assign_selection++;
      if (servo_assign_selection >= planeVisibleCount()) servo_assign_selection = 0;
      menu_down_pressed = true;
    } else if (!buttonLeftDown) {
      menu_down_pressed = false;
    }

    if (buttonRightLeft && !servo_output_dec_latch) {
      uint8_t logicalId = planeLogicalId(servo_assign_selection);
      servo_channel_map[logicalId] = findNextFreeServoOutput(logicalId, -1);
      updatePlaneServoMap();
      servo_output_dec_latch = true;
    } else if (!buttonRightLeft) {
      servo_output_dec_latch = false;
    }

    if (buttonRightDown && !servo_output_inc_latch) {
      uint8_t logicalId = planeLogicalId(servo_assign_selection);
      servo_channel_map[logicalId] = findNextFreeServoOutput(logicalId, +1);
      updatePlaneServoMap();
      servo_output_inc_latch = true;
    } else if (!buttonRightDown) {
      servo_output_inc_latch = false;
    }

    if (buttonRightUp && !servo_back_latch) {
      servo_back_latch = true;
      updatePlaneServoMap();
      current_screen = SCREEN_PLANE_TYPE;
    } else if (!buttonRightUp) {
      servo_back_latch = false;
    }

  } else if (current_screen == SCREEN_SERVO_MIX) {
    if (buttonLeftUp && !menu_up_pressed) {
      servo_reverse_selection--;
      if (servo_reverse_selection < 0) servo_reverse_selection = 5;
      menu_up_pressed = true;
    } else if (!buttonLeftUp) {
      menu_up_pressed = false;
    }

    if (buttonLeftDown && !menu_down_pressed) {
      servo_reverse_selection++;
      if (servo_reverse_selection > 5) servo_reverse_selection = 0;
      menu_down_pressed = true;
    } else if (!buttonLeftDown) {
      menu_down_pressed = false;
    }

    // Right-Up toggles only the selected physical servo S1..S6.
    if (buttonRightUp && !servo_reverse_toggle_latch) {
      servo_reverse_mask ^= (uint8_t)(1U << servo_reverse_selection);
      updatePlaneServoMap();
      servo_reverse_toggle_latch = true;
    } else if (!buttonRightUp) {
      servo_reverse_toggle_latch = false;
    }

    if (buttonRightDown && !servo_reverse_back_latch) {
      servo_reverse_back_latch = true;
      current_screen = SCREEN_MENU;
    } else if (!buttonRightDown) {
      servo_reverse_back_latch = false;
    }

  } else if (current_screen == SCREEN_ALL_TRIMS) {
    if (buttonLeftUp && !trim_lu_latch) {
      trim_selection--;
      if (trim_selection < 0) trim_selection = 3;
      trim_lu_latch = true;
    } else if (!buttonLeftUp) {
      trim_lu_latch = false;
    }

    if (buttonLeftDown && !trim_ld_latch) {
      trim_selection++;
      if (trim_selection > 3) trim_selection = 0;
      trim_ld_latch = true;
    } else if (!buttonLeftDown) {
      trim_ld_latch = false;
    }

    if (buttonRightLeft && !trim_rl_latch) {
      switch (trim_selection) {
        case 0: if (trim_aileron > -100) trim_aileron--; break;
        case 1: if (trim_elevator > -100) trim_elevator--; break;
        case 2: if (trim_rudder > -100) trim_rudder--; break;
        case 3: if (trim_flaps > -100) trim_flaps--; break;
      }
      trim_rl_latch = true;
      trim_adjust_mode = true;
    } else if (!buttonRightLeft) {
      trim_rl_latch = false;
    }

    if (buttonLeftRight && !trim_rr_latch) {
      switch (trim_selection) {
        case 0: if (trim_aileron < 100) trim_aileron++; break;
        case 1: if (trim_elevator < 100) trim_elevator++; break;
        case 2: if (trim_rudder < 100) trim_rudder++; break;
        case 3: if (trim_flaps < 100) trim_flaps++; break;
      }
      trim_rr_latch = true;
      trim_adjust_mode = true;
    } else if (!buttonLeftRight) {
      trim_rr_latch = false;
    }

    if (buttonRightDown && !trim_exit_latch) {
      trim_exit_latch = true;
      trim_adjust_mode = false;
      current_screen = SCREEN_MENU;
    } else if (!buttonRightDown) {
      trim_exit_latch = false;
    }

  } else if (current_screen == SCREEN_DUAL_RATES) {

    if (buttonLeftUp && !menu_up_pressed) {
      rate_value += 5;
      if (rate_value > 100) rate_value = 100;
      menu_up_pressed = true;
    } else if (!buttonLeftUp) {
      menu_up_pressed = false;
    }

    if (buttonLeftDown && !menu_down_pressed) {
      rate_value -= 5;
      if (rate_value < 0) rate_value = 0;
      menu_down_pressed = true;
    } else if (!buttonLeftDown) {
      menu_down_pressed = false;
    }

    if (buttonLeftLeft && !menu_select_pressed) {
      expo_value -= 5;
      if (expo_value < 0) expo_value = 0;
      menu_select_pressed = true;
    } else if (!buttonLeftLeft) {
      menu_select_pressed = false;
    }

    if (buttonLeftRight && !menu_exit_pressed) {
      expo_value += 5;
      if (expo_value > 100) expo_value = 100;
      menu_exit_pressed = true;
    } else if (!buttonLeftRight) {
      menu_exit_pressed = false;
    }

    if (buttonRightDown && !menu_down_pressed) {
      menu_down_pressed = true;
      current_screen = SCREEN_MENU;
    } else if (!buttonRightDown) {
      menu_down_pressed = false;
    }

  } else if (current_screen == SCREEN_DASHBOARD) {
    if (buttonLeftUp && !menu_up_pressed) {
      flapPosition--;
      if (flapPosition < 0) flapPosition = 0;
      menu_up_pressed = true;
    } else if (!buttonLeftUp) {
      menu_up_pressed = false;
    }

    if (buttonLeftDown && !menu_down_pressed) {
      flapPosition++;
      if (flapPosition > 2) flapPosition = 2;
      menu_down_pressed = true;
    } else if (!buttonLeftDown) {
      menu_down_pressed = false;
    }

    txData.channels[7] = map(flapPosition, 0, 2, 0, 4095);

    if (buttonRightDown && !menu_exit_pressed) {
      menu_exit_pressed = true;
      current_screen = SCREEN_MENU;
    } else if (!buttonRightDown) {
      menu_exit_pressed = false;
    }
  } else {
    if (buttonRightDown && !menu_exit_pressed) {
      menu_exit_pressed = true;
      current_screen = SCREEN_MENU;
    } else if (!buttonRightDown) {
      menu_exit_pressed = false;
    }
  }
}

