void getTxClock(char *out) {
  const char *t = __TIME__;
  uint32_t base = ((uint32_t)(t[0]-'0') * 10UL + (uint32_t)(t[1]-'0')) * 3600UL;
  base += ((uint32_t)(t[3]-'0') * 10UL + (uint32_t)(t[4]-'0')) * 60UL;
  base += ((uint32_t)(t[6]-'0') * 10UL + (uint32_t)(t[7]-'0'));
  uint32_t nowSec = (base + millis()/1000UL) % 86400UL;
  uint8_t hh = (uint8_t)(nowSec / 3600UL);
  uint8_t mm = (uint8_t)((nowSec / 60UL) % 60UL);
  snprintf_P(out, 6, PSTR("%02u:%02u"), hh, mm);
}

