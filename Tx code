void drawMenuScreen() {
  uint8_t cur=(uint8_t)item_selected;
  if(!menuCarouselState.init){
    menuCarouselState.shown=cur; menuCarouselState.from=cur;
    menuCarouselState.dir=-1; menuCarouselState.started=millis(); menuCarouselState.init=true;
  }
  if(cur!=menuCarouselState.shown){
    uint8_t old=menuCarouselState.shown;
    menuCarouselState.from=old;
    menuCarouselState.dir=(cur==(uint8_t)((old+1U)%NUM_ITEMS))?-1:1;
    menuCarouselState.shown=cur;
    menuCarouselState.started=millis();
  }

  drawHeader(PSTR("SYSTEM"),cur+1U,NUM_ITEMS);
  uint32_t e=(uint32_t)(millis()-menuCarouselState.started);
  int travel=(e>=180U)?48:(int)(e*48UL/180UL);
