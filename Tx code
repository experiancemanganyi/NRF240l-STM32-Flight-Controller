uint8_t planeLogicalId(uint8_t i) {
  if (plane_type == PLANE_WING) {
    static const uint8_t map6[6] PROGMEM = {0,2,4,5,6,7};
    if (i > 5) i = 5;
    return pgm_read_byte(&map6[i]);
  }

  if (plane_type == PLANE_V_TAIL) {
    static const uint8_t map8[8] PROGMEM = {0,1,3,2,4,5,6,7};
    if (i > 7) i = 7;
    return pgm_read_byte(&map8[i]);
  }

  return (i > 7) ? 7 : i;
}

