static int kineticEase(int from,int to,uint32_t started,uint16_t duration) {
  uint32_t e=(uint32_t)(millis()-started);
  if(e>=duration) return to;
  // Smoothstep-ish integer ease: fast start, soft landing.
  long t=(long)e*256L/(long)duration;
  long q=(t*t*(768L-2L*t))>>16;
  return from + (int)(((long)(to-from)*q)>>8);
}

static void drawRoundedBitmapScroll(uint8_t index,uint8_t count,SmoothScrollState &s) {
  if(count<=1U) return;
  const int x=120,y=14,travel=38;
  int target=y+((int)index*travel)/(count-1U);
  if(!s.init){s.fromY=s.toY=target;s.started=millis();s.init=true;}
  if(target!=s.toY){
    s.fromY=kineticEase(s.fromY,s.toY,s.started,150U);
    s.toY=target;s.started=millis();
  }
  int thumbY=kineticEase(s.fromY,s.toY,s.started,150U);
  u8g.drawBitmapP(x,y,1,48,bmp_ui_scroll_rail_8x48);
  u8g.drawBitmapP(x,thumbY,1,10,bmp_ui_scroll_thumb_8x10);
}

static int selectedSlideX(int8_t current,SlideState &s) {
  if(!s.init){s.last=current;s.dir=0;s.started=millis();s.init=true;return 0;}
  if(current!=s.last){
    int8_t d=(current>s.last)?1:-1;
    // Preserve natural direction through wraparound.
    if(s.last==0 && current>2) d=-1;
    if(current==0 && s.last>2) d=1;
    s.dir=d;s.last=current;s.started=millis();
  }
  uint32_t e=(uint32_t)(millis()-s.started);
  if(e>=150U) return 0;
  return (int)s.dir*(10-(int)(e*10UL/150UL));
}

