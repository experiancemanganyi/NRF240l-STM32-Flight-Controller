bool initDisplayHardware() {
  displayRendering = false;

  uint8_t ok = u8g.begin();
  u8g.setColorIndex(1);

  displayInitialized = (ok != 0);
  displayLastInitAttempt = millis();
  displayLastProgress = displayLastInitAttempt;
  lastDisplayUpdate = displayLastInitAttempt - DISPLAY_INTERVAL;
  return displayInitialized;
}

void drawFirstDisplayFrameBlocking() {
  if (!displayInitialized) return;

  displayScreenSnapshot = (uint8_t)current_screen;
  u8g.firstPage();
  do {
    drawCurrentScreenPage();
  } while (u8g.nextPage());

  displayRendering = false;
  displayLastProgress = millis();
  lastDisplayUpdate = displayLastProgress;
}

void serviceDisplay() {

  if (radioTxBusy) return;

  unsigned long now = millis();

  if (!displayInitialized) {
    if ((unsigned long)(now - displayLastInitAttempt) >= DISPLAY_REINIT_RETRY) {
      initDisplayHardware();
    }
    return;
  }

  if (displayRendering &&
      (unsigned long)(now - displayLastProgress) > DISPLAY_FRAME_TIMEOUT) {
    displayRendering = false;
    displayInitialized = false;
    displayLastInitAttempt = now - DISPLAY_REINIT_RETRY;
    return;
  }

  if (!displayRendering) {
    if ((unsigned long)(now - lastDisplayUpdate) < DISPLAY_INTERVAL) return;

    displayScreenSnapshot = (uint8_t)current_screen;
    displayFrameStart = now;
    displayLastProgress = now;
    u8g.firstPage();
    displayRendering = true;
  }

  drawCurrentScreenPage();
  bool morePages = u8g.nextPage();
  displayLastProgress = millis();

  if (!morePages) {
    displayRendering = false;
    lastDisplayUpdate = displayLastProgress;
  }
}

const unsigned long BOOT_LOGO_TIME_MS = 2200UL;
const unsigned long LINK_READY_TIME_MS = 1500UL;

void drawBlockingAnimatedPage(void (*drawFn)(), unsigned long durationMs) {
  if (!displayInitialized) {
    delay(durationMs);
    return;
  }

  unsigned long start = millis();
  while ((unsigned long)(millis() - start) < durationMs) {
    u8g.firstPage();
    do { drawFn(); } while (u8g.nextPage());
    delay(70);
  }
  displayRendering = false;
  displayLastProgress = millis();
  lastDisplayUpdate = displayLastProgress;
}

void updateStartupRadioResult(int8_t radioResult, unsigned long now) {
  if (radioResult == 1 || radioResult == 2) {
    linkAttempts++;
    uint8_t packetScore = (lastRetryCount >= 10) ? 10 : (uint8_t)(100 - lastRetryCount * 9);
    linkScoreSum += packetScore;
    packetCount++;
    radioConnected = true;
    lastTelemetryTime = now;
  } else if (radioResult == -1) {
    linkAttempts++;
  }
}

void serviceStartupRadioTraffic(bool drawSearch) {
  unsigned long now = millis();
  unsigned long nowUs = micros();

  int8_t result = serviceDataTx();
  updateStartupRadioResult(result, now);

  if ((unsigned long)(nowUs - lastInputUpdateUs) >= INPUT_UPDATE_INTERVAL_US) {
    lastInputUpdateUs = nowUs;
    updateControlInputsFast();
    nowUs = micros();
  }

  if (radioReady && !radioTxBusy &&
      (unsigned long)(nowUs - lastControlSendUs) >= CONTROL_SEND_INTERVAL_US) {
    lastControlSendUs = nowUs;
    startDataTx();
  }

  static unsigned long lastBootDraw = 0;
  if (displayInitialized && (unsigned long)(now - lastBootDraw) >= 85UL && !radioTxBusy) {
    lastBootDraw = now;
    u8g.firstPage();
    do {
      if (drawSearch) drawRadioSearchScreen();
      else drawLinkReadyScreen();
    } while (u8g.nextPage());
  }
}

void waitForRealFcLink() {
  radioConnected = false;
  telemetryReceived = false;
  lastControlSendUs = micros() - CONTROL_SEND_INTERVAL_US;

  while (!radioConnected) {
    serviceStartupRadioTraffic(true);
  }
}

void showLinkedReadyWhileCommunicating(unsigned long durationMs) {
  unsigned long start = millis();
  while ((unsigned long)(millis() - start) < durationMs) {
    serviceStartupRadioTraffic(false);
  }
}

void setup() {
  memset(&txData, 0, sizeof(txData));

  pinMode(Toggle1, INPUT_PULLUP);
  pinMode(Toggle2, INPUT_PULLUP);
  pinMode(Toggle3, INPUT_PULLUP);
  pinMode(Toggle4, INPUT_PULLUP);

  softSPI_init();
  nrf_ce_low();
  nrf_csn_high();
  radioConfigured = false;
  radioReady = false;
  radioState = RADIO_IDLE;
  radioTxBusy = false;

  lastValidBatteryPerc = 0;
  telemetryData.batteryMv = 0;
  telemetryData.batteryPercent = 0;
  telemetryData.flags = 0;
  telemetryData.packetCount = 0;
  telemetryData.currentCentiAmp = 0;
  telemetryData.consumedMah = 0;
  telemetryData.linkQuality = 0;
  telemetryData.state = 0;
  telemetryData.rollDeg = 0;
  telemetryData.pitchDeg = 0;
  telemetryData.calibrationProgress = 0;

  lastToggle1 = digitalRead(Toggle1) == LOW;
  lastToggle2 = digitalRead(Toggle2) == LOW;
  lastToggle3 = digitalRead(Toggle3) == LOW;
  lastToggle4 = digitalRead(Toggle4) == LOW;

  loadSettings();
  loadPlaneServoMap();
  updateControlInputsFast();
  lastInputUpdateUs = micros();

  delay(120);
  displayLastInitAttempt = 0;
  initDisplayHardware();

  drawBlockingAnimatedPage(drawBootSplashScreen, BOOT_LOGO_TIME_MS);

  radio_init();
  delay(6);
  radioReady = true;
  lastControlSendUs = micros() - CONTROL_SEND_INTERVAL_US;

  bool nrfOk =
      (read_register(CONFIG) == 0x0E) &&
      (read_register(SETUP_AW) == 0x03) &&
      (read_register(RF_CH) == 100);

  if (!nrfOk) {
    while (1) {
      if (displayInitialized) {
        u8g.firstPage();
        do { drawRadioBootScreen(false); } while (u8g.nextPage());
      }
      delay(100);
    }
  }

  waitForRealFcLink();

  showLinkedReadyWhileCommunicating(LINK_READY_TIME_MS);

  displayRendering = false;
  displayLastProgress = millis();
  lastDisplayUpdate = displayLastProgress - DISPLAY_INTERVAL;

  lastTelemetryTime = millis();
  lastLinkQualityUpdate = millis();
  drawFirstDisplayFrameBlocking();
}

void updateControlInputsFast() {
  rawCX = readAnalogPinClean(JoyContX);
  rawCY = readAnalogPinClean(JoyContY);
  rawThr = readAnalogPinClean(JoySpeedX);
  rawPot = readAnalogPinClean(POT_PIN);

  uint16_t rawAileron = (uint16_t)mapJoystickToChannel(rawCX, centerX, DEADZONE_X);
  uint16_t rawElevator = (uint16_t)mapJoystickToChannel(rawCY, centerY, DEADZONE_Y);

  txData.channels[0] = applyExpoRateChannel(rawAileron);
  txData.channels[1] = applyExpoRateChannel(rawElevator);

  int trimOffsetAil = map(trim_aileron, -100, 100, -200, 200);
  int trimOffsetEle = map(trim_elevator, -100, 100, -200, 200);

  txData.channels[0] = constrain(txData.channels[0] + trimOffsetAil, 0, 4095);
  txData.channels[1] = constrain(txData.channels[1] + trimOffsetEle, 0, 4095);

  // Throttle power curve:
  // - Keeps true idle at 0.
  // - Reaches full command slightly before the mechanical top stop, so a pot
  //   that does not quite reach ADC 1023 still gives the ESC a full 2000 us.
  // - Adds a progressive mid-stick boost so 40-50% stick no longer feels
  //   excessively weak. Full stick is still exactly 100%; no over-range is sent.
  long throttleNorm = map(rawThr, speedMin, speedMax, 0, 1000);
  throttleNorm = constrain(throttleNorm, 0L, 1000L);

  if (throttleNorm <= 5L) {
    throttleNorm = 0L;
  } else if (throttleNorm >= 930L) {
    // Top 7% of the physical pot is treated as full throttle.
    throttleNorm = 1000L;
  } else {
    // Progressive boost: x + 0.5*x*(1-x).
    // Approx: 20% stick -> 28%, 40% -> 52%, 50% -> 63%,
    // while 100% remains 100%.
    throttleNorm += (throttleNorm * (1000L - throttleNorm)) / 2000L;
    if (throttleNorm > 1000L) throttleNorm = 1000L;
  }

  txData.channels[2] = (uint16_t)((throttleNorm * 4095L + 500L) / 1000L);

  int potMapped = map(rawPot, potMin, potMax, 0, 4095);
  txData.channels[6] = (uint16_t)constrain(potMapped, 0, 4095);

  handleToggles();
  readButtons();

  int yawChannel = 2048;
  if (buttonLeftLeft && !buttonLeftRight) yawChannel = 0;
  else if (buttonLeftRight && !buttonLeftLeft) yawChannel = 4095;

  int trimOffsetRud = map(trim_rudder, -100, 100, -200, 200);
  txData.channels[3] = constrain(yawChannel + trimOffsetRud, 0, 4095);

  txData.buttons[0] = buttonLeftUp;
  txData.buttons[1] = buttonLeftLeft;
  txData.buttons[2] = buttonLeftRight;
  txData.buttons[3] = buttonLeftDown;
  txData.buttons[4] = buttonRightUp;
  txData.buttons[5] = buttonRightLeft;
  txData.buttons[6] = buttonRightRight;
  txData.buttons[7] = buttonRightDown;

  handleMenuButtons();

}

void loop() {
  int8_t radioResult = serviceDataTx();
  unsigned long now = millis();

  if (radioResult == 1 || radioResult == 2) {
    linkAttempts++;
    uint8_t packetScore = (lastRetryCount >= 10) ? 10 : (uint8_t)(100 - lastRetryCount * 9);
    linkScoreSum += packetScore;
    packetCount++;
    radioConnected = true;
    lastTelemetryTime = now;
  } else if (radioResult == -1) {
    linkAttempts++;
    if ((unsigned long)(now - lastTelemetryTime) > LINK_TIMEOUT) {
      radioConnected = false;
    }
  }

  unsigned long nowUs = micros();

  if ((unsigned long)(nowUs - lastInputUpdateUs) >= INPUT_UPDATE_INTERVAL_US) {
    lastInputUpdateUs = nowUs;
    updateControlInputsFast();
    nowUs = micros();
  }

  if (radioReady &&
      !radioTxBusy &&
      (unsigned long)(nowUs - lastControlSendUs) >= CONTROL_SEND_INTERVAL_US) {
    lastControlSendUs = nowUs;
    startDataTx();
    return;
  }

  if ((unsigned long)(now - lastLinkQualityUpdate) >= 500UL) {
    lastLinkQualityUpdate = now;
    linkQuality = linkAttempts ? (uint8_t)(linkScoreSum / linkAttempts) : 0;
    if (!radioConnected) linkQuality = 0;
    linkAttempts = 0;
    linkScoreSum = 0;
  }

  if ((unsigned long)(now - lastTelemetryReceive) > 1500UL) {
    telemetryReceived = false;
  }

  serviceDisplay();
}
