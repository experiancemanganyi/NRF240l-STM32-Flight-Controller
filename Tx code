bool fcImuCalibrating() {
  if (!telemetryReceived) return false;

  if ((telemetryData.state & 0x08U) != 0U) return true;

  if ((telemetryData.state & 0x02U) == 0U && telemetryData.calibrationProgress < 100U) {
    return true;
  }

  return false;
}

void drawSignalGlyph(int x, int y, uint8_t quality) {
  uint8_t bars = 0;
  if (quality >= 85) bars = 4;
  else if (quality >= 60) bars = 3;
  else if (quality >= 35) bars = 2;
  else if (quality >= 10) bars = 1;
  for (uint8_t i = 0; i < 4; i++) {
    int h = 2 + i * 2;
    int bx = x + i * 4;
    int by = y + 8 - h;
    if (i < bars) u8g.drawRBox(bx, by, 3, h, 1);
    else u8g.drawRFrame(bx, by, 3, h, 1);
  }
}



